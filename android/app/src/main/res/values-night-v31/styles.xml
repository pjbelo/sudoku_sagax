<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows the system splash screen (the app icon on a
         background colour) before LaunchTheme's windowBackground. Make it
         Sagax navy to match the app and the iOS launch screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/sagax_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/sagax_navy</item>
    </style>
</resources>
